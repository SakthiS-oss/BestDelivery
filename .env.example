# Copy to .env. Never commit .env.

# When true, disasters, news, and explanations stay local (no Snowflake, no Ollama).
USE_MOCK_DATA=false

# Repo-root paths, read by the backend.
MOCK_CITIES_PATH=data/mock/cities.csv
MOCK_DISASTERS_PATH=data/mock/disasters.json
MOCK_NEWS_PATH=data/mock/news.json

# Snowflake. Used only when USE_MOCK_DATA=false.
# Queries stay read-only; table names come from this file, filters are bound parameters.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
SNOWFLAKE_DISASTER_TABLE=
# Default if empty: BBCGOOGLECNN_NEWS_LISTING.PUBLIC.BBC_NEWS
SNOWFLAKE_NEWS_TABLE=

# Ollama. Used only when USE_MOCK_DATA=false.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Routing and scoring knobs. Code applies these; the model does not.
AVG_SPEED_MPH=55
MIN_HOP_MILES=150
MAX_HOP_MILES=350
ROAD_FACTOR=1.25
CANDIDATE_ROUTE_COUNT=3
HAZARD_WEIGHT_HOURS=10
NEWS_WEIGHT_HOURS=6
NEWS_LOOKBACK_DAYS=7

# Frontend (Vite reads the repo-root .env).
VITE_API_BASE_URL=http://127.0.0.1:8000
