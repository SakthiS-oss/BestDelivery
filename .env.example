# Copy to .env. Never commit .env.

# When true, hazards, news, and explanations stay on local files.
# Snowflake and Ollama are not contacted. The code default is true when this is unset.
USE_MOCK_DATA=true

# Snowflake. Used only when USE_MOCK_DATA=false.
# Queries are read-only SELECTs. Table names are checked as identifiers.
# Filters are bound parameters, including the as-of cutoff.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
# Default if empty: AMBEE_GLOBAL_NATURAL_DISASTERS_DATA_HISTORICAL_AND_PRESENT_CONDITIONS.ND.ND_ACTUALS
SNOWFLAKE_DISASTER_TABLE=
# Default if empty: BBCGOOGLECNN_NEWS_LISTING.PUBLIC.BBC_NEWS
SNOWFLAKE_NEWS_TABLE=

# Ollama. Used for news classification and, when EXPLAIN_PROVIDER=ollama, route prose.
# Mock mode skips both calls.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Route explanations. ollama uses the model above. cloud uses an OpenAI-compatible
# endpoint and an open-weight model. Scores are still computed in Python.
EXPLAIN_PROVIDER=ollama
CLOUD_MODEL_BASE_URL=
CLOUD_MODEL_API_KEY=
CLOUD_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct

# Optional. SQLite file for news classification labels. Article text is not stored.
# NEWS_CACHE_PATH=

# Seconds before an HTTP request returns 504. Default 60.
# REQUEST_TIMEOUT_SECONDS=60

# Frontend. Vite reads the repo-root .env.
VITE_API_BASE_URL=http://127.0.0.1:8000
